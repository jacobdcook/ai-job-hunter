# Single key (works fine)
GROQ_API_KEY=your_groq_api_key_here

# Multiple keys (comma-separated) - auto-rotates on rate limit
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# Model (default: llama-3.1-8b-instant). Each model has its own TPD quota on Groq.
# GROQ_MODEL=llama-3.1-8b-instant

# When primary model hits daily limit (429), try these next (comma-separated).
# Example: use gpt-oss-20b and 70b as fallbacks (each has separate TPD).
# GROQ_MODEL_FALLBACK=openai/gpt-oss-20b,llama-3.3-70b-versatile
